{
  "name": "wg-chores-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test -c e2e --trace off",
    "e2e:layout": "playwright test -c e2e --project layout --trace off",
    "e2e:build": "npm run build && touch ../server/build.rs && cd ../server && cargo build --features test-util --bins"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
